{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task|SendMessage|Workflow|Read|Write|Edit|MultiEdit|NotebookEdit|Grep|Glob|Bash|PowerShell|Monitor|mcp__plugin_fairlead_fairlead__.*",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/fairlead_hook.mjs\"" }]
      }
    ],
    "PostToolUse": [{ "matcher": ".*", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/fairlead_hook.mjs\"" }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/fairlead_hook.mjs\"" }] }],
    "SubagentStart": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/fairlead_hook.mjs\"" }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/fairlead_hook.mjs\"" }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/fairlead_hook.mjs\"" }] }]
  }
}
